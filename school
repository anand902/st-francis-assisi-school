loadMarkSheet=function(){const container=document.getElementById('markSheetContainer');if(!container)return;const exam=document.getElementById('examType').value,cls=document.getElementById('markClass').value,sec=document.getElementById('markSection').value;if(!exam||!cls||!sec){originalLoadMarkSheet();return;}if(currentUser?.type==='teacher'){const teacher=teachers.find(item=>item.id===currentUser.id),assignedClass=teacher?.classTeacher||'';if(assignedClass!==cls+' - '+sec){container.innerHTML='<div style="text-align:center;padding:40px;color:var(--danger);"><i class="fas fa-lock fa-3x" style="margin-bottom:12px;display:block;"></i><strong>Access Denied</strong><p style="margin-top:8px;color:var(--text-secondary);">You are not the Class Teacher of '+cls+' - '+sec+'</p><p style="color:var(--text-secondary);">Only the assigned Class Teacher or Principal can enter marks.</p></div>';return;}}if(currentUser?.type==='student'){container.innerHTML='<div style="text-align:center;padding:40px;color:var(--danger);"><i class="fas fa-lock fa-3x" style="margin-bottom:12px;display:block;"></i><strong>Access Denied</strong><p style="margin-top:8px;color:var(--text-secondary);">Students cannot enter marks.</p></div>';return;}originalLoadMarkSheet();};
const originalAutoSaveMark=autoSaveMark;
autoSaveMark=function(input){if(currentUser?.type==='teacher'){const teacher=teachers.find(item=>item.id===currentUser.id),assignedClass=teacher?.classTeacher||'',selectedClassSec=document.getElementById('markClass').value+' - '+document.getElementById('markSection').value;if(assignedClass!==selectedClassSec){showToast('❌ You are not the Class Teacher of this class!','error');loadMarkSheet();return;}}if(currentUser?.type==='student'){showToast('❌ Students cannot enter marks.','error');return;}originalAutoSaveMark(input);};
const originalLoadMarkSheetView=loadMarkSheetView;
loadMarkSheetView=function(){const container=document.getElementById('markSheetViewContainer');if(!container)return;if(currentUser?.type==='student'){container.innerHTML='<div style="text-align:center;padding:40px;color:var(--danger);"><i class="fas fa-lock fa-3x"></i><p>Go to "My Marks" to view your marks.</p></div>';return;}if(currentUser?.type==='accountant'){container.innerHTML='<div style="text-align:center;padding:40px;color:var(--danger);"><i class="fas fa-lock fa-3x"></i><p>Access Denied</p></div>';return;}if(currentUser?.type==='teacher'){const teacher=teachers.find(item=>item.id===currentUser.id),assignedClass=teacher?.classTeacher||'',selectedClass=document.getElementById('viewMarkClass').value+' - '+document.getElementById('viewMarkSection').value;if(assignedClass!==selectedClass){container.innerHTML='<div style="text-align:center;padding:40px;color:var(--danger);"><i class="fas fa-lock fa-3x"></i><p>You can only view marks for your own class: <strong>'+(assignedClass||'None')+'</strong></p></div>';return;}}originalLoadMarkSheetView();};

function addNoticeNavItem(){const nav=document.getElementById('sidebarNav');if(!nav||currentUser?.type!=='admin'||document.getElementById('noticesNavItem'))return;const item=document.createElement('button');item.id='noticesNavItem';item.className='nav-item';item.innerHTML='<i class="fas fa-bullhorn"></i>Notices';item.onclick=function(){openPage('notices',item);loadAllNotices();};const qrItem=Array.from(nav.querySelectorAll('.nav-item')).find(button=>button.textContent.trim()==='QR Codes');if(qrItem)qrItem.after(item);}
const originalBuildSidebar=buildSidebar;
function addTeacherMarkNavItems(){const nav=document.getElementById('sidebarNav');if(!nav||currentUser?.type!=='teacher')return;const teacher=teachers.find(item=>item.id===currentUser.id);if(!teacher){nav.innerHTML='<button class="nav-item active"><i class="fas fa-exclamation-triangle"></i>Teacher Not Found</button>';return;}let items='<button class="nav-item active" onclick="openPage(\'teacher-attendance\',this);loadTeacherAttendance();"><i class="fas fa-clipboard-check"></i>View My Attendance</button>';items+='<button class="nav-item" onclick="openPage(\'student-attendance\',this);"><i class="fas fa-calendar-check"></i>Student Attendance</button>';if(teacher.classTeacher){items+='<button class="nav-item" onclick="openPage(\'marksheet\',this);"><i class="fas fa-edit"></i>Mark Entry ('+teacher.classTeacher+')</button>';items+='<button class="nav-item" onclick="openPage(\'mark-view\',this);"><i class="fas fa-eye"></i>View Marks ('+teacher.classTeacher+')</button>';}items+='<button class="nav-item" onclick="openPage(\'students\',this);loadStudents();"><i class="fas fa-users"></i>My Students</button>';nav.innerHTML=items;}
function addStudentMarkNavItem(){const nav=document.getElementById('sidebarNav');if(!nav||currentUser?.type!=='student'||document.getElementById('studentMarksNavItem'))return;const item=document.createElement('button');item.id='studentMarksNavItem';item.className='nav-item';item.innerHTML='<i class="fas fa-file-alt"></i>My Mark Sheet';item.onclick=function(){openPage('student-marks',item);loadStudentMarks();};nav.appendChild(item);}
function addMarkNavItems(){const nav=document.getElementById('sidebarNav');if(!nav||currentUser?.type!=='admin'||document.getElementById('markSettingsNavItem'))return;const entries=[['markSettingsNavItem','mark-settings','⚙️ Mark Settings'],['markEntryNavItem','marksheet','📝 Mark Entry'],['markViewNavItem','mark-view','📊 View Marks']];const noticesItem=document.getElementById('noticesNavItem');entries.forEach(([id,page,label])=>{const item=document.createElement('button');item.id=id;item.className='nav-item';item.innerHTML='<i class="fas fa-edit"></i>'+label;item.onclick=function(){openPage(page,item);if(page==='mark-settings')loadMarkSettings();};if(noticesItem)noticesItem.after(item);else nav.appendChild(item);});}
buildSidebar=function(){originalBuildSidebar();addNoticeNavItem();addMarkNavItems();addTeacherMarkNavItems();addStudentMarkNavItem();};
const originalOpenPage=openPage;
openPage=function(name,el){originalOpenPage(name,el);const titles={'notices':'Notices & Announcements','mark-settings':'Mark Sheet Settings','marksheet':'Mark Sheet Entry','mark-view':'View Mark Sheet','student-marks':'My Mark Sheet'};if(titles[name])document.getElementById('pageTitle').textContent=titles[name];};
const originalAppStart=appStart;
appStart=function(){originalAppStart();loadNoticeBoard();loadMarkSettings();};
(function(){const s=localStorage.getItem('theme');if(s)document.documentElement.setAttribute('data-theme',s);console.log('✅ St. Francis of Assisi School - System Ready');})();
</script>
</body>
</html>
