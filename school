function buildFeeTableHTML(tableId,feeData,prefix,readOnly){let html='';FEE_COMPONENTS.forEach((comp,i)=>{html+=`<tr><td>${FEE_ICONS[i]} ${comp}</td>`;CLASS_LIST.forEach((cls,ci)=>{const val=(feeData[cls]||DEFAULT_FEES[cls])[i]||0;if(readOnly){html+=`<td><span class="fee-readonly">${val}</span></td>`;}else{html+=`<td><input type="number" class="${prefix}-fee-input" data-row="${i}" data-col="${ci}" value="${val}" style="width:50px;"></td>`;}});html+='</tr>';});html+=`<tr class="total-col"><td><strong>💰 TOTAL</strong></td>`;CLASS_LIST.forEach(cls=>{html+=`<td><span class="${prefix}-class-total" data-class="${cls}">₹0</span></td>`;});html+='</tr>';document.querySelector(`#${tableId} tbody`).innerHTML=html;}
function updateFeeTotals(prefix,feeData){CLASS_LIST.forEach((cls,ci)=>{let t=0;FEE_COMPONENTS.forEach((comp,i)=>{const inp=document.querySelectorAll(`.${prefix}-fee-input[data-row="${i}"]`);if(inp.length>ci){const v=parseInt(inp[ci].value)||0;t+=(comp.includes('Tuition'))?v*12:v;}});const el=document.querySelector(`.${prefix}-class-total[data-class="${cls}"]`);if(el)el.textContent='₹'+t.toLocaleString('en-IN');});}
