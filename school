function submitAdmission(){const pd=document.getElementById('admPhotoData')?.value||'';const cls=document.getElementById('stuClass').value,sec=document.getElementById('stuSection').value;if(!cls||!sec){showToast('Select class & section','warning');return false;}const s={id:Date.now(),admissionNo:document.getElementById('admNoPreview').textContent,name:document.getElementById('stuName').value,email:document.getElementById('stuEmail').value,phone:document.getElementById('stuPhone').value,dob:document.getElementById('stuDOB').value,gender:document.getElementById('stuGender').value,bloodGroup:document.getElementById('stuBlood').value,religion:document.getElementById('stuReligion')?.value||'',class:cls,section:sec,fatherName:document.getElementById('fatherName').value,motherName:document.getElementById('motherName').value,parentPhone:document.getElementById('parentPhone').value,parentEmail:document.getElementById('parentEmail').value,admissionDate:new Date().toISOString().split('T')[0],paymentMethod:document.getElementById('admissionPaymentMethod').value,photo:pd,status:'Active'};students.push(s);localStorage.setItem('sfaStudents',JSON.stringify(students));let feeHTML='',totalFee=0;FEE_COMPONENTS.forEach((comp,i)=>{const val=(admissionFees[cls]||DEFAULT_FEES[cls])[i]||0;const amt=(comp.includes('Tuition'))?val*12:val;feeHTML+=`<tr><td>${FEE_ICONS[i]} ${comp}</td><td>₹${amt.toLocaleString('en-IN')}</td></tr>`;totalFee+=amt;});const rn='ADM-RCP-'+Date.now();const modal=document.getElementById('admissionReceiptModal');modal.style.display='block';modal.innerHTML=`<div class="receipt-overlay" onclick="this.parentElement.style.display='none'"><div class="receipt-paper" onclick="event.stopPropagation()"><div class="receipt-header"><div class="school-logo">✝️</div><h2>St. Francis of Assisi School</h2><p>Admission Receipt</p><small>Receipt No: ${rn}</small></div><div class="receipt-body"><div class="receipt-section"><h4>📋 Student Info</h4><div class="receipt-row"><span>Adm No:</span><span>${s.admissionNo}</span></div><div class="receipt-row"><span>Name:</span><span>${s.name}</span></div><div class="receipt-row"><span>Class:</span><span>${cls} - Section ${sec}</span></div><div class="receipt-row"><span>Father:</span><span>${s.fatherName||'N/A'}</span></div></div><div class="receipt-section"><h4>💰 Fee Structure 2026-2027</h4><table class="fee-summary-table">${feeHTML}<tr class="total-row"><td><strong>TOTAL</strong></td><td><strong>₹${totalFee.toLocaleString('en-IN')}</strong></td></tr></table></div></div><div class="receipt-footer"><div class="receipt-stamp"><div class="stamp-line"></div>Authorized Signatory</div></div><div style="padding:16px;text-align:right;"><button class="btn btn-primary btn-sm" onclick="window.print()">🖨️ Print</button><button class="btn btn-outline btn-sm" onclick="this.closest('.receipt-overlay').parentElement.style.display='none'">✕ Close</button></div></div></div>`;document.getElementById('admissionForm').reset();removeAdmPhoto();updateAdmissionNo();showToast('✅ Student admitted!','success');return false;}

