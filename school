function loadReAdmissionData(){const sid=parseInt(document.getElementById('reAdmissionStudent').value);const preview=document.getElementById('reAdmissionPreview');const feeSection=document.getElementById('reAdmissionFeeSection');if(!sid){preview.style.display='none';feeSection.style.display='none';return;}const s=students.find(x=>x.id===sid);if(!s)return;preview.style.display='block';feeSection.style.display='block';preview.innerHTML=`<div style="padding:12px;background:var(--primary-light);border-radius:8px;"><strong>${s.name}</strong> | ${s.admissionNo} | Current: ${s.class} ${s.section}</div>`;}
function submitReAdmission(){const sid=parseInt(document.getElementById('reAdmissionStudent').value);const nc=document.getElementById('reAdmissionClass').value;const ns=document.getElementById('reAdmissionSection').value;if(!sid||!nc||!ns){showToast('Fill all fields','warning');return;}const s=students.find(x=>x.id===sid);if(!s)return;s.class=nc;s.section=ns;s.reAdmissionDate=new Date().toISOString().split('T')[0];s.reAdmissionAmountPaid=parseFloat(document.getElementById('reAdmissionAmountPaid').value)||0;localStorage.setItem('sfaStudents',JSON.stringify(students));let feeHTML='',totalFee=0;FEE_COMPONENTS.forEach((comp,i)=>{const val=(reAdmissionFees[nc]||DEFAULT_FEES[nc])[i]||0;const amt=(comp.includes('Tuition'))?val*12:val;feeHTML+=`<tr><td>${FEE_ICONS[i]} ${comp}</td><td>₹${amt.toLocaleString('en-IN')}</td></tr>`;totalFee+=amt;});const rn='READM-RCP-'+Date.now();const modal=document.getElementById('reAdmissionReceiptModal');modal.style.display='block';modal.innerHTML=`<div class="receipt-overlay" onclick="this.parentElement.style.display='none'"><div class="receipt-paper" onclick="event.stopPropagation()"><div class="receipt-header"><div class="school-logo">✝️</div><h2>St. Francis of Assisi School</h2><p>Re-Admission Receipt 2026-2027</p><small>Receipt No: ${rn}</small></div><div class="receipt-body"><div style="text-align:center;margin-bottom:16px;"><span class="re-admission-badge">🔄 RE-ENTRY</span></div><div class="receipt-section"><h4>📋 Info</h4><div class="receipt-row"><span>Student:</span><span>${s.name}</span></div><div class="receipt-row"><span>New Class:</span><span>${nc} - Section ${ns}</span></div></div><div class="receipt-section"><h4>💰 Fee Structure 2026-2027</h4><table class="fee-summary-table">${feeHTML}<tr class="total-row"><td><strong>TOTAL</strong></td><td><strong>₹${totalFee.toLocaleString('en-IN')}</strong></td></tr></table></div></div><div class="receipt-footer"><div class="receipt-stamp"><div class="stamp-line"></div>Authorized Signatory</div></div><div style="padding:16px;text-align:right;"><button class="btn btn-primary btn-sm" onclick="window.print()">🖨️ Print</button><button class="btn btn-outline btn-sm" onclick="this.closest('.receipt-overlay').parentElement.style.display='none'">✕ Close</button></div></div></div>`;showToast('✅ Re-Admission completed!','success');}

function populateSubjectGrid(teacherId){const grid=document.getElementById('teacherSubjectGrid');let html='<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:8px;">';const existingSubs=teacherId?(teachers.find(t=>t.id===teacherId)?.subjects||[]):[];CLASS_LIST.forEach(cls=>{html+=`<div style="background:#F8FAFC;padding:8px;border-radius:8px;border:1px solid var(--border);"><strong style="font-size:11px;">${cls}</strong><br>`;SUBJECTS.forEach(sub=>{const checked=existingSubs.includes(`${cls}:${sub}`)?'checked':'';html+=`<label style="font-size:10px;display:block;cursor:pointer;"><input type="checkbox" class="tch-subject-cb" value="${cls}:${sub}" ${checked}> ${sub}</label>`;});html+='</div>';});html+='</div>';grid.innerHTML=html;}
function populateClassTeacherOptions(){const sel=document.getElementById('tchClassTeacher');let opts='<option value="">Not Assigned</option>';CLASS_LIST.forEach(cls=>{['A','B'].forEach(sec=>{opts+=`<option value="${cls} - ${sec}">${cls} - Section ${sec}</option>`;});});sel.innerHTML=opts;}
function showTeacherForm(tid){document.getElementById('teacherFormCard').style.display='block';document.getElementById('teacherFormTitle').textContent=tid?'✏️ Edit Teacher':'📝 Add Teacher';removeTchPhoto();populateClassTeacherOptions();populateSubjectGrid(tid||null);if(tid){const t=teachers.find(x=>x.id===tid);if(t){document.getElementById('tchId').value=t.id;document.getElementById('tchName').value=t.name||'';document.getElementById('tchEmail').value=t.email||'';document.getElementById('tchPhone').value=t.phone||'';document.getElementById('tchSubject').value=t.subject||'';document.getElementById('tchQualification').value=t.qualification||'';document.getElementById('tchExperience').value=t.experience||0;document.getElementById('tchClassTeacher').value=t.classTeacher||'';document.getElementById('tchEmpIdPreview').textContent=t.employeeId;if(t.photo){const pv=document.getElementById('tchPhotoPreview');if(pv){pv.style.backgroundImage=`url(${t.photo})`;pv.innerHTML='';pv.classList.add('has-photo');}document.getElementById('tchPhotoData').value=t.photo;document.getElementById('tchRemovePhotoBtn').style.display='inline-flex';}}}else{document.getElementById('tchId').value='';document.getElementById('teacherForm').reset();document.getElementById('tchEmpIdPreview').textContent='TCH-'+new Date().getFullYear()+'-'+String(teachers.length+1).padStart(3,'0');}}
function saveTeacher(){const id=document.getElementById('tchId').value;const pd=document.getElementById('tchPhotoData')?.value||'';const cbs=document.querySelectorAll('.tch-subject-cb:checked');const subjects=Array.from(cbs).map(cb=>cb.value);const primarySubject=subjects.length>0?subjects[0].split(':')[1]:document.getElementById('tchSubject').value;const td={name:document.getElementById('tchName').value,email:document.getElementById('tchEmail').value,phone:document.getElementById('tchPhone').value,subject:primarySubject,subjects:subjects,qualification:document.getElementById('tchQualification').value,experience:parseInt(document.getElementById('tchExperience').value)||0,classTeacher:document.getElementById('tchClassTeacher').value,status:'Active',photo:pd,hasPhoto:!!pd};if(id){Object.assign(teachers.find(x=>x.id===parseInt(id)),td);}else{teachers.push({id:Date.now(),employeeId:document.getElementById('tchEmpIdPreview').textContent,...td});}localStorage.setItem('sfaTeachers',JSON.stringify(teachers));document.getElementById('teacherFormCard').style.display='none';loadTeachers();showToast('✅ Teacher saved!','success');return false;}
function loadTeachers(){document.getElementById('teachersTableBody').innerHTML=teachers.length?teachers.map(t=>{const ph=t.photo?`<div class="table-photo" style="background-image:url(${t.photo});background-size:cover;"></div>`:`<div class="table-photo">${t.name.charAt(0)}</div>`;const ct=t.classTeacher?`<span class="class-teacher-badge">🏫 ${t.classTeacher}</span>`:'-';return`<tr><td>${ph}</td><td><strong>${t.employeeId}</strong></td><td>${t.name}</td><td>${t.subject}</td><td>${ct}</td><td><button class="btn btn-outline btn-sm" onclick="showTeacherForm(${t.id})">✏️</button></td></tr>`;}).join(''):'<tr><td colspan="6">No teachers</td></tr>';}

function isAttendanceLocked(date){if(!date)return false;const now=new Date();const today=new Date().toISOString().split('T')[0];if(date!==today)return true;const attRecords=teacherAttendance.filter(a=>a.date===date);if(attRecords.length===0)return false;const firstMark=attRecords[0].markedAt?new Date(attRecords[0].markedAt):new Date();return(now-firstMark)/60000>30;}
function loadTeacherAttendance(){const date=document.getElementById('teacherAttDate')?.value||new Date().toISOString().split('T')[0];const locked=isAttendanceLocked(date);document.getElementById('attendanceLockStatus').innerHTML=locked?'<span class="lock-badge">🔒 LOCKED</span>':'<span class="auto-save-indicator">💾 Auto-save ON</span>';let html='<div class="table-card"><table><thead><tr><th>Emp ID</th><th>Name</th><th>Subject</th><th>Status</th></tr></thead><tbody>';teachers.forEach(t=>{const ex=teacherAttendance.find(a=>a.teacherId===t.id&&a.date===date);const status=ex?ex.status:'present';html+=`<tr class="${locked?'attendance-locked':''}"><td><strong>${t.employeeId}</strong></td><td>${t.name}</td><td>${t.subject}</td><td><select class="form-input tatt-status" data-id="${t.id}" ${locked?'disabled':''} onchange="autoSaveTeacherAttendance(this)"><option value="present" ${status==='present'?'selected':''}>✅ Present</option><option value="absent" ${status==='absent'?'selected':''}>❌ Absent</option><option value="leave" ${status==='leave'?'selected':''}>📝 Leave</option></select></td></tr>`;});html+='</tbody></table></div>';document.getElementById('teacherAttendanceSheet').innerHTML=html;}
function autoSaveTeacherAttendance(sel){const date=document.getElementById('teacherAttDate').value;teacherAttendance=teacherAttendance.filter(a=>!(a.teacherId===parseInt(sel.dataset.id)&&a.date===date));teacherAttendance.push({teacherId:parseInt(sel.dataset.id),status:sel.value,date,markedAt:new Date().toISOString()});localStorage.setItem('sfaTeacherAttendance',JSON.stringify(teacherAttendance));showToast('✅ Saved!','success');}
function loadStudentAttendance(){const c=document.getElementById('attClass').value,s=document.getElementById('attSection').value,co=document.getElementById('attendanceSheet');if(!c||!s){co.innerHTML='<p>Select class & section</p>';return;}const l=students.filter(x=>x.class===c&&x.section===s);co.innerHTML=l.length?`<table class="table-card"><thead><tr><th>Adm No.</th><th>Name</th><th>Status</th></tr></thead><tbody>${l.map(x=>`<tr><td>${x.admissionNo}</td><td>${x.name}</td><td><select class="form-input satt-status" data-id="${x.id}"><option value="present">✅ Present</option><option value="absent">❌ Absent</option></select></td></tr>`).join('')}</tbody></table><button class="btn btn-primary btn-sm" onclick="saveStudentAttendance()" style="margin-top:10px;">💾 Save</button>`:'<p>No students</p>';}
function saveStudentAttendance(){const d=document.getElementById('attDate').value,c=document.getElementById('attClass').value,s=document.getElementById('attSection').value,rec=[];document.querySelectorAll('.satt-status').forEach(x=>{const st=students.find(y=>y.id===parseInt(x.dataset.id));if(st)rec.push({studentId:st.id,studentName:st.name,status:x.value,date:d,class:c,section:s});});studentAttendance=studentAttendance.filter(x=>!(x.date===d&&x.class===c&&x.section===s));studentAttendance.push(...rec);localStorage.setItem('sfaStudentAttendance',JSON.stringify(studentAttendance));showToast('✅ Saved!','success');}

function searchStudentForFee(){const query=document.getElementById('feeSearchStudent').value.trim().toLowerCase();const resultsDiv=document.getElementById('feeStudentSearchResults');if(query.length<2){resultsDiv.innerHTML='';return;}const results=students.filter(s=>s.name.toLowerCase().includes(query)||s.admissionNo.toLowerCase().includes(query));if(results.length===0){resultsDiv.innerHTML='<div style="padding:10px;color:var(--text-secondary);text-align:center;">No students found</div>';return;}resultsDiv.innerHTML=results.map(s=>`<div onclick="selectStudentForFee(${s.id})" style="padding:10px;border-bottom:1px solid var(--border);cursor:pointer;display:flex;align-items:center;gap:10px;"><div class="table-photo">${s.name.charAt(0)}</div><div style="flex:1;"><strong>${s.name}</strong><div style="font-size:11px;color:var(--text-secondary);">${s.admissionNo} | ${s.class}-${s.section}</div></div></div>`).join('');}
function selectStudentForFee(studentId){const student=students.find(s=>s.id===studentId);if(!student)return;document.getElementById('feeSelectedStudentId').value=studentId;document.getElementById('feeSearchStudent').value=student.name;document.getElementById('feeStudentSearchResults').innerHTML='';document.getElementById('feeStudentProfile').style.display='block';document.getElementById('feeStudentProfileContent').innerHTML=`<div style="display:flex;align-items:center;gap:16px;padding:12px;background:var(--primary-light);border-radius:10px;"><div class="photo-preview" style="width:60px;height:60px;font-size:20px;margin:0;cursor:default;">${student.name.charAt(0)}</div><div><h3>${student.name}</h3><div style="font-size:12px;color:var(--text-secondary);">${student.admissionNo} | ${student.class}-${student.section}<br>Father: ${student.fatherName||'N/A'} | Religion: ${student.religion||'N/A'}</div></div></div>`;const classFee=admissionFees[student.class]||DEFAULT_FEES[student.class];if(classFee)document.getElementById('feeAmount').value=classFee[classFee.length-1]||0;loadFeePaymentHistory(studentId);}
function loadFeePaymentHistory(studentId){const student=students.find(s=>s.id===studentId);if(!student)return;const studentFees=feeRecords.filter(r=>r.studentId===studentId);const totalPaid=studentFees.reduce((sum,r)=>sum+(r.total||r.amount||0),0);const allMonths=['April 2026','May 2026','June 2026','July 2026','August 2026','September 2026','October 2026','November 2026','December 2026','January 2027','February 2027','March 2027'];const paidMonths=studentFees.filter(r=>r.feeMonth).map(r=>r.feeMonth);let html='<div style="margin-bottom:12px;padding:10px;background:#F0FDF4;border-radius:8px;display:flex;justify-content:space-between;">';html+=`<span><strong>Total Paid:</strong> <span style="color:#22C55E;">₹${totalPaid.toLocaleString('en-IN')}</span></span><span><strong>Receipts:</strong> ${studentFees.length}</span></div>`;html+='<div style="display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin-bottom:16px;">';allMonths.forEach(month=>{const paid=paidMonths.includes(month);html+=`<div class="fee-month-box${paid?'':' unpaid'}"><div style="font-size:14px;">${paid?'✅':'❌'}</div><div style="font-weight:600;color:${paid?'#22C55E':'#EF4444'};">${month.split(' ')[0].substring(0,3)}</div></div>`;});html+='</div>';if(studentFees.length>0){html+='<table class="table-card"><thead><tr><th>Receipt</th><th>Month</th><th>Amount</th><th>Date</th></tr></thead><tbody>';studentFees.reverse().forEach(r=>{html+=`<tr><td><strong>${r.receiptNo}</strong></td><td>${r.feeMonth||'-'}</td><td>₹${(r.total||r.amount||0).toLocaleString('en-IN')}</td><td>${r.date}</td></tr>`;});html+='</tbody></table>';}document.getElementById('feePaymentHistory').innerHTML=html;}
function collectFeeForStudent(){const studentId=parseInt(document.getElementById('feeSelectedStudentId').value);const student=students.find(s=>s.id===studentId);if(!student){showToast('Select a student first','warning');return;}const amount=parseFloat(document.getElementById('feeAmount').value)||0;if(amount<=0){showToast('Enter valid amount','warning');return;}const feeMonth=document.getElementById('feeMonth').value;const category=document.getElementById('feeCategory').value;const method=document.getElementById('feeMethod').value;const date=document.getElementById('feeDate').value||new Date().toISOString().split('T')[0];const transactionId=document.getElementById('feeTransactionId').value;const rn='RCP-'+new Date().getFullYear()+'-'+String(feeRecords.length+1).padStart(3,'0');const record={id:Date.now(),receiptNo:rn,studentId:student.id,studentName:student.name,admissionNo:student.admissionNo,class:student.class,section:student.section,category:category,amount:amount,total:amount,feeMonth:feeMonth,method:method,date:date,transactionId:transactionId,collectedBy:currentUser?.name||'Accountant'};feeRecords.push(record);localStorage.setItem('sfaFees',JSON.stringify(feeRecords));document.getElementById('feeReceiptContainer').innerHTML=`<div style="background:white;padding:20px;border:2px dashed #E2E8F0;border-radius:12px;margin-top:16px;"><div style="text-align:center;border-bottom:2px solid #F59E0B;"><h3>St. Francis of Assisi School</h3><p>Receipt #${rn}</p></div><div class="receipt-row"><span>Student:</span><strong>${student.name}</strong></div><div class="receipt-row"><span>Month:</span><span>${feeMonth||'N/A'}</span></div><div class="receipt-row" style="font-weight:700;font-size:16px;border-top:2px solid #E2E8F0;padding-top:8px;"><span>Amount:</span><span style="color:#22C55E;">₹${amount.toLocaleString('en-IN')}</span></div><button class="btn btn-primary btn-sm" onclick="window.print()" style="margin-top:10px;">🖨️ Print</button></div>`;document.getElementById('feeAmount').value='';document.getElementById('feeMonth').value='';loadFeePaymentHistory(studentId);showToast('✅ Fee collected!','success');}

function loadFeeRecords(){document.getElementById('feeRecordsTableBody').innerHTML=feeRecords.length?feeRecords.reverse().map(r=>`<tr><td><strong>${r.receiptNo}</strong></td><td>${r.studentName}</td><td>${r.class}</td><td>${r.feeMonth||'-'}</td><td>₹${r.total||r.amount||0}</td><td>${r.date}</td></tr>`).join(''):'<tr><td colspan="6">No records</td></tr>';}
function loadStudents(){const s=(document.getElementById('studentSearch')?.value||'').toLowerCase();let f=students;if(s)f=f.filter(x=>x.name.toLowerCase().includes(s)||x.admissionNo.toLowerCase().includes(s));document.getElementById('studentsTableBody').innerHTML=f.length?f.map(x=>`<tr><td><div class="table-photo">${x.name.charAt(0)}</div></td><td><strong>${x.admissionNo}</strong></td><td>${x.name}</td><td><span class="badge ${x.gender==='Male'?'badge-primary':'badge-info'}">${x.gender}</span></td><td>${x.religion||'-'}</td><td>${x.class}</td><td>Sec ${x.section}</td></tr>`).join(''):'<tr><td colspan="7">No students</td></tr>';}
function loadStudentSelf(){if(!currentUser||!currentUser.id)return;const s=students.find(x=>x.id===currentUser.id);if(!s)return;document.getElementById('studentSelfView').innerHTML=`<div class="form-grid"><div class="form-group"><label>Admission No.</label><div class="form-input" style="background:#F8FAFC;">${s.admissionNo}</div></div><div class="form-group"><label>Name</label><div class="form-input" style="background:#F8FAFC;">${s.name}</div></div><div class="form-group"><label>Class</label><div class="form-input" style="background:#F8FAFC;">${s.class}-${s.section}</div></div><div class="form-group"><label>Gender</label><div class="form-input" style="background:#F8FAFC;">${s.gender}</div></div><div class="form-group"><label>DOB</label><div class="form-input" style="background:#F8FAFC;">${s.dob}</div></div><div class="form-group"><label>Religion</label><div class="form-input" style="background:#F8FAFC;">${s.religion||'N/A'}</div></div></div>`;}

function createNotice(){const n={id:Date.now(),title:document.getElementById('noticeTitle').value.trim(),message:document.getElementById('noticeMessage').value.trim(),type:document.getElementById('noticeType').value,for:document.getElementById('noticeFor').value,date:new Date().toISOString().split('T')[0],createdBy:currentUser?.name||'Principal'};notices.unshift(n);localStorage.setItem('sfaNotices',JSON.stringify(notices));document.getElementById('noticeForm').reset();loadAllNotices();loadNoticeBoard();showToast('✅ Notice published!','success');return false;}
function loadNoticeBoard(){const container=document.getElementById('noticeList');if(!container)return;const visible=notices.filter(n=>n.for==='All'||currentUser?.type==='admin'||(currentUser?.type==='teacher'&&n.for==='Teachers Only')||(currentUser?.type==='student'&&n.for==='Students Only')||(currentUser?.type==='accountant'&&n.for==='Accountant Only')).slice(0,5);container.innerHTML=visible.length?visible.map(n=>`<div class="notice-item ${n.type.toLowerCase()==='urgent'?'urgent':n.type.toLowerCase()==='important'?'info':''}"><h4>${n.title} <span class="notice-badge ${n.type.toLowerCase()==='important'?'info':n.type.toLowerCase()}" >${n.type}</span></h4><p>${n.message}</p><div class="notice-date">📅 ${n.date} | By: ${n.createdBy} | For: ${n.for}</div></div>`).join(''):'<p style="color:var(--text-secondary);font-size:12px;">No notices</p>';}
function loadAllNotices(){const table=document.getElementById('noticesTableBody');if(!table)return;table.innerHTML=notices.length?notices.map(n=>`<tr><td><strong>${n.title}</strong></td><td><span class="badge ${n.type==='Urgent'?'badge-danger':n.type==='Important'?'badge-warning':'badge-success'}">${n.type}</span></td><td>${n.for}</td><td>${n.date}</td><td><button class="btn btn-danger btn-sm" onclick="deleteNotice(${n.id})">🗑️</button></td></tr>`).join(''):'<tr><td colspan="5">No notices</td></tr>';}
function deleteNotice(id){if(!confirm('Delete notice?'))return;notices=notices.filter(n=>n.id!==id);localStorage.setItem('sfaNotices',JSON.stringify(notices));loadAllNotices();loadNoticeBoard();showToast('Notice deleted','warning');}

function saveMarkSettings(){markSettings.ut1Full=Math.max(1,parseInt(document.getElementById('ut1Full').value)||25);markSettings.ut1Pass=Math.max(0,parseInt(document.getElementById('ut1Pass').value)||9);markSettings.ut2Full=Math.max(1,parseInt(document.getElementById('ut2Full').value)||25);markSettings.ut2Pass=Math.max(0,parseInt(document.getElementById('ut2Pass').value)||9);markSettings.hyFull=Math.max(1,parseInt(document.getElementById('hyFull').value)||100);markSettings.hyPass=Math.max(0,parseInt(document.getElementById('hyPass').value)||25);markSettings.anFull=Math.max(1,parseInt(document.getElementById('anFull').value)||100);markSettings.anPass=Math.max(0,parseInt(document.getElementById('anPass').value)||33);localStorage.setItem('sfaMarkSettings',JSON.stringify(markSettings));loadMarkSettings();showToast('✅ Mark settings saved!','success');}
function loadMarkSettings(){['ut1Full','ut1Pass','ut2Full','ut2Pass','hyFull','hyPass','anFull','anPass'].forEach(key=>{const input=document.getElementById(key);if(input)input.value=markSettings[key];});}
function getMarkLimits(exam){return exam==='ut1'?{full:markSettings.ut1Full,pass:markSettings.ut1Pass}:exam==='ut2'?{full:markSettings.ut2Full,pass:markSettings.ut2Pass}:exam==='hy'?{full:markSettings.hyFull,pass:markSettings.hyPass}:{full:markSettings.anFull,pass:markSettings.anPass};}
function loadMarkSheet(){const exam=document.getElementById('examType').value,cls=document.getElementById('markClass').value,sec=document.getElementById('markSection').value,container=document.getElementById('markSheetContainer');if(!exam||!cls||!sec){container.innerHTML='';return;}const list=students.filter(student=>student.class===cls&&student.section===sec);if(!list.length){container.innerHTML='<p style="text-align:center;padding:20px;">No students found</p>';return;}const limits=getMarkLimits(exam),subjects=SUBJECTS.slice(0,6);let html='<div style="overflow-x:auto;"><table class="mark-sheet-table"><thead><tr><th>Adm No.</th><th>Student Name</th>';subjects.forEach(subject=>{html+='<th>'+subject+'</th>';});html+='<th>Total</th><th>Result</th></tr></thead><tbody>';list.forEach(student=>{const key=exam+'_'+student.id,existing=marksData[key]||{};let total=0,allPass=true;html+='<tr><td>'+student.admissionNo+'</td><td class="subject-col">'+student.name+'</td>';subjects.forEach(subject=>{const value=existing[subject]??'';if(value!==''&&!isNaN(value)){total+=parseInt(value);if(parseInt(value)<limits.pass)allPass=false;}html+='<td><input type="number" class="mark-input" data-exam="'+exam+'" data-student="'+student.id+'" data-subject="'+subject+'" value="'+value+'" min="0" max="'+limits.full+'" onchange="autoSaveMark(this)"></td>';});const result=total>0?(allPass?'<span class="pass">✅ PASS</span>':'<span class="fail">❌ FAIL</span>'):'-';html+='<td class="total-row">'+total+'</td><td>'+result+'</td></tr>';});html+='</tbody></table></div><div style="font-size:10px;color:var(--text-secondary);margin-top:8px;">Full Marks: '+limits.full+' | Pass Marks: '+limits.pass+' | Changes save automatically</div>';container.innerHTML=html;}
function autoSaveMark(input){const exam=input.dataset.exam,studentId=parseInt(input.dataset.student),subject=input.dataset.subject,limits=getMarkLimits(exam);let value=parseInt(input.value);if(isNaN(value)||value<0)value=0;if(value>limits.full)value=limits.full;const key=exam+'_'+studentId;if(!marksData[key])marksData[key]={};marksData[key][subject]=value;localStorage.setItem('sfaMarks',JSON.stringify(marksData));loadMarkSheet();}
function loadMarkSheetView(){const exam=document.getElementById('viewExamType').value,cls=document.getElementById('viewMarkClass').value,sec=document.getElementById('viewMarkSection').value,container=document.getElementById('markSheetViewContainer');if(!exam||!cls||!sec){container.innerHTML='';return;}const list=students.filter(student=>student.class===cls&&student.section===sec);if(!list.length){container.innerHTML='<p style="text-align:center;padding:20px;">No students found</p>';return;}const limits=getMarkLimits(exam),subjects=SUBJECTS.slice(0,6);let html='<div style="overflow-x:auto;"><table class="mark-sheet-table"><thead><tr><th>Adm No.</th><th>Student Name</th>';subjects.forEach(subject=>{html+='<th>'+subject+'</th>';});html+='<th>Total</th><th>%</th><th>Result</th></tr></thead><tbody>';list.forEach(student=>{const existing=marksData[exam+'_'+student.id]||{};let total=0,allPass=true;html+='<tr><td>'+student.admissionNo+'</td><td class="subject-col">'+student.name+'</td>';subjects.forEach(subject=>{const value=parseInt(existing[subject])||0;total+=value;if(value<limits.pass)allPass=false;html+='<td>'+value+'</td>';});const maxTotal=limits.full*subjects.length,percent=maxTotal?Math.round((total/maxTotal)*100):0;html+='<td class="total-row">'+total+'/'+maxTotal+'</td><td>'+percent+'%</td><td>'+(allPass?'<span class="pass">✅ PASS</span>':'<span class="fail">❌ FAIL</span>')+'</td></tr>';});html+='</tbody></table></div>';container.innerHTML=html;}
function loadStudentMarks(){const container=document.getElementById('studentMarksContainer');if(!container)return;if(!currentUser||!currentUser.id){container.innerHTML='<p style="text-align:center;padding:40px;">Please login first.</p>';return;}const student=students.find(item=>item.id===currentUser.id);if(!student){container.innerHTML='<p style="text-align:center;padding:40px;">Student data not found.</p>';return;}const exams=[{key:'ut1',name:'1st Unit Test'},{key:'ut2',name:'2nd Unit Test'},{key:'hy',name:'Half Yearly'},{key:'an',name:'📌 Annual Exam'}];let html='<div style="margin-bottom:16px;padding:12px;background:var(--primary-light);border-radius:10px;text-align:center;"><strong style="font-size:16px;">'+student.name+'</strong><br>'+student.admissionNo+' | '+student.class+' - Section '+student.section+'</div>',hasMarks=false;exams.forEach(exam=>{const data=marksData[exam.key+'_'+student.id]||{},limits=getMarkLimits(exam.key),subjects=SUBJECTS.slice(0,6);let total=0,count=0,allPass=true;subjects.forEach(subject=>{const value=parseInt(data[subject])||0;if(value>0){total+=value;count++;if(value<limits.pass)allPass=false;}});if(!count)return;hasMarks=true;html+='<div class="form-section"><h3 class="form-section-title">'+exam.name+' (Full: '+limits.full+' | Pass: '+limits.pass+')</h3><table class="mark-sheet-table"><thead><tr><th>Subject</th><th>Marks</th><th>Status</th></tr></thead><tbody>';subjects.forEach(subject=>{const value=parseInt(data[subject])||0;html+='<tr><td class="subject-col">'+subject+'</td><td>'+value+'</td><td>'+(value>0?(value>=limits.pass?'<span class="pass">✅ Pass</span>':'<span class="fail">❌ Fail</span>'):'-')+'</td></tr>';});const maxTotal=limits.full*subjects.length;html+='<tr class="total-row"><td><strong>Total</strong></td><td><strong>'+total+'/'+maxTotal+'</strong></td><td><strong>'+(allPass?'<span class="pass">✅ PASS</span>':'<span class="fail">❌ FAIL</span>')+'</strong></td></tr></tbody></table></div>';});container.innerHTML=hasMarks?html:'<div style="text-align:center;padding:40px;color:var(--text-secondary);"><i class="fas fa-file-alt fa-3x" style="margin-bottom:12px;display:block;opacity:0.5;"></i>No marks entered yet.<br><small>Your marks will appear here once entered by your Class Teacher.</small></div>';}

function updateQRSelects(){const ss=document.getElementById('qrStudentSelect');const ts=document.getElementById('qrTeacherSelect');if(ss)ss.innerHTML='<option value="">Select Student</option>'+students.map(s=>`<option value="${s.id}">${s.name} (${s.admissionNo}) - ${s.class} ${s.section}</option>`).join('');if(ts)ts.innerHTML='<option value="">Select Teacher</option>'+teachers.map(t=>`<option value="${t.id}">${t.name} (${t.employeeId}) - ${t.subject}</option>`).join('');}
function generateQR(type){const selectId=type==='student'?'qrStudentSelect':'qrTeacherSelect';const id=parseInt(document.getElementById(selectId)?.value);const display=document.getElementById(type+'QRDisplay');if(!id||!display){if(display)display.innerHTML='<p style="color:#94A3B8;">Select a '+type+' to generate QR</p>';return;}const p=type==='student'?students.find(s=>s.id===id):teachers.find(t=>t.id===id);if(!p)return;const d=type==='student'?{type:'Student',admissionNo:p.admissionNo,name:p.name,class:p.class,section:p.section,father:p.fatherName||'',school:'St. Francis of Assisi School'}:{type:'Teacher',employeeId:p.employeeId,name:p.name,subject:p.subject,school:'St. Francis of Assisi School'};display.innerHTML='';try{new QRCode(display,{text:JSON.stringify(d),width:160,height:160,colorDark:'#1E3A5F',colorLight:'#FFFFFF',correctLevel:QRCode.CorrectLevel.H});qrCodes[type+'_'+id]={data:d,generatedAt:new Date().toISOString()};localStorage.setItem('sfaQRCodes',JSON.stringify(qrCodes));showToast('✅ QR Generated!','success');}catch(e){display.innerHTML='<p style="color:#EF4444;">Error generating QR. Please refresh.</p>';console.error('QR Error:',e);}}

function openPage(name,el){document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));document.querySelectorAll('.nav-item').forEach(n=>n.classList.remove('active'));const pg=document.getElementById('page-'+name);if(pg)pg.classList.add('active');if(el)el.classList.add('active');document.getElementById('pageTitle').textContent={'dashboard':'Dashboard','fee-structure':'Fee Structure Settings','admission':'New Admission','re-admission':'Re-Admission 2026-2027','students':'Students','student-self':'My Profile','teachers':'Teachers','teacher-attendance':'Teacher Attendance','student-attendance':'Student Attendance','fee-collection':'Collect Fee','fee-records':'Payment History','qrcodes':'QR Codes'}[name]||'';}
