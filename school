function showToast(m,t){const c={success:'#22C55E',warning:'#F59E0B',error:'#EF4444',info:'#8B5CF6'};const o=document.createElement('div');o.className='toast';o.style.background=c[t]||c.info;o.textContent=m;document.body.appendChild(o);setTimeout(()=>o.remove(),3000);}
function dashboardSearch(){const query=document.getElementById('dashboardSearch').value.trim().toLowerCase();const results=document.getElementById('searchResults');if(query.length<2){results.classList.remove('show');return;}const matches=[];students.forEach(student=>{if(student.name.toLowerCase().includes(query)||student.admissionNo.toLowerCase().includes(query))matches.push({type:'student',id:student.id,name:student.name,detail:student.admissionNo+' | '+student.class+' - Section '+student.section,extra:student.fatherName||'',photo:student.photo||''});});teachers.forEach(teacher=>{if(teacher.name.toLowerCase().includes(query)||teacher.employeeId.toLowerCase().includes(query))matches.push({type:'teacher',id:teacher.id,name:teacher.name,detail:teacher.employeeId+' | '+teacher.subject,extra:teacher.qualification||'',photo:teacher.photo||''});});if(!matches.length){results.innerHTML='<div style="padding:16px;text-align:center;color:var(--text-secondary);">No results found</div>';results.classList.add('show');return;}results.innerHTML=matches.slice(0,10).map(match=>`<div class="search-result-item" onclick="showQuickProfile('${match.type}',${match.id})"><div class="result-photo"${match.photo?` style="background-image:url(${match.photo});"`:''}>${match.photo?'':match.name.charAt(0)}</div><div class="result-info"><div class="result-name">${match.name}</div><div class="result-detail">${match.detail}</div></div><span class="result-badge badge-${match.type==='student'?'primary':'info'}">${match.type==='student'?'🎒 Student':'👨‍🏫 Teacher'}</span></div>`).join('');results.classList.add('show');}
function showQuickProfile(type,id){const person=type==='student'?students.find(student=>student.id===id):teachers.find(teacher=>teacher.id===id);if(!person)return;document.getElementById('searchResults').classList.remove('show');document.getElementById('dashboardSearch').value='';const modal=document.getElementById('quickProfileModal');modal.style.display='block';const photoStyle=person.photo?`background-image:url(${person.photo});` : '';const photoContent=person.photo?'':person.name.charAt(0);const details=type==='student'?`<div class="form-group"><label>Class</label><div class="form-input">${person.class} - Section ${person.section}</div></div><div class="form-group"><label>Gender</label><div class="form-input">${person.gender}</div></div><div class="form-group"><label>Father</label><div class="form-input">${person.fatherName||'N/A'}</div></div><div class="form-group"><label>Phone</label><div class="form-input">${person.parentPhone||'N/A'}</div></div>`:`<div class="form-group"><label>Subject</label><div class="form-input">${person.subject}</div></div><div class="form-group"><label>Qualification</label><div class="form-input">${person.qualification||'N/A'}</div></div><div class="form-group"><label>Class Teacher</label><div class="form-input">${person.classTeacher||'Not Assigned'}</div></div>`;modal.innerHTML=`<div class="quick-profile-overlay" onclick="this.parentElement.style.display='none'"><div class="quick-profile-card" onclick="event.stopPropagation()" style="position:relative;"><button class="close-btn" onclick="this.closest('#quickProfileModal').style.display='none'">✕</button><div class="photo-preview" style="width:80px;height:80px;font-size:28px;margin:0 auto 16px;cursor:default;${photoStyle}">${photoContent}</div><h3>${person.name}</h3><p style="color:var(--text-secondary);">${type==='student'?person.admissionNo:person.employeeId}</p><div class="form-grid" style="text-align:left;margin-top:16px;">${details}</div></div></div>`;}
