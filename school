function compressAndPreview(input,type){const file=input.files[0];if(!file)return;if(!file.type.match(/image\/(jpeg|png|jpg)/)){showToast('Select JPG/PNG','warning');return;}const oKb=Math.round(file.size/1024);const p=type==='adm'?'adm':'tch';const r=new FileReader();r.onload=function(e){const img=new Image();img.onload=function(){const c=document.createElement('canvas'),x=c.getContext('2d');let w=img.width,h=img.height,M=400;if(w>h&&w>M){h=Math.round((h*M)/w);w=M;}else if(h>M){w=Math.round((w*M)/h);h=M;}c.width=w;c.height=h;x.fillStyle='#FFF';x.fillRect(0,0,w,h);x.drawImage(img,0,0,w,h);let q=0.9,res=c.toDataURL('image/jpeg',q),kb=Math.round((res.length*3)/4096);while(kb>100&&q>0.1){q-=0.1;res=c.toDataURL('image/jpeg',q);kb=Math.round((res.length*3)/4096);}if(kb>100){const s=Math.sqrt(100/kb);w=Math.round(w*s);h=Math.round(h*s);c.width=w;c.height=h;x.fillStyle='#FFF';x.fillRect(0,0,w,h);x.drawImage(img,0,0,w,h);res=c.toDataURL('image/jpeg',0.7);kb=Math.round((res.length*3)/4096);}const pv=document.getElementById(p+'PhotoPreview');if(pv){pv.style.backgroundImage=`url(${res})`;pv.innerHTML='';pv.classList.add('has-photo');}document.getElementById(p+'PhotoData').value=res;document.getElementById(p+'PhotoInfo').innerHTML=`<span class="size-ok">✅ ${kb}KB</span>`;document.getElementById(p+'RemovePhotoBtn').style.display='inline-flex';};img.src=e.target.result;};r.readAsDataURL(file);}
